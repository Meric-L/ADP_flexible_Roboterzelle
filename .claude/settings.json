{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/doku_regeln.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15,
            "statusMessage": "Projektregeln und doc/-Index laden"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/doku_regeln.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15,
            "statusMessage": "Projektregeln an Subagent uebergeben"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/doku_regeln.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15,
            "once": true,
            "statusMessage": "Erinnerung: doc/ lesen und Arbeitsplan anlegen"
          }
        ]
      }
    ]
  }
}
