{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/doc_rules.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15,
            "statusMessage": "Loading project rules and doc/ index"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/doc_rules.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15,
            "statusMessage": "Passing project rules to subagent"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/doc_rules.py\"; [ -f \"$f\" ] && python3 \"$f\" || true",
            "timeout": 15,
            "once": true,
            "statusMessage": "Reminder: read doc/ and create a work plan"
          }
        ]
      }
    ]
  }
}
