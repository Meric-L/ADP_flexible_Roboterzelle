!data/rohbilder/
*.txt
*.bat
*.sh
# Ausnahmen: diese Dateien sind versioniert (neue Dateien dieser Typen
# bleiben sonst fuer `git add` unsichtbar)
!requirements.txt
!/setup.sh
!/setup.bat
.venv/
.venv*/
__pycache__/
*.pyc
*.log
*.pem
*.der
*.jpg



# Claude-Code-Konfiguration: Regeln, Skill und Hooks gehoeren ins Repo,
# damit sie jedes Teammitglied nach dem Clonen hat. Persoenliche Overrides
# und Worktrees bleiben draussen.
.claude/settings.local.json
.claude/worktrees/

# Kalibrierdaten: nur die beiden cam_flange.json versionieren, der Rest (Aufnahmen, Backups,
# weitere JSONs) bleibt lokal. Bereits getrackte Dateien bleiben davon unberuehrt.
data/calibration/**
!data/calibration/cam_flange.json

# Hand-Auge-Sitzungen und Tag-Referenzaufnahmen: lokal, nicht versionieren
data/handeye/**
!data/handeye/cam_flange.json
data/tagreference/

# LaTeX-Ausarbeitung (Sync mit ShareLaTeX): alle Quell- und Bilddateien versionieren,
# auch .jpg/.txt, die oben global ignoriert werden. Lokale Build-Artefakte bleiben draussen.
!latex/**
latex/**/*.aux
latex/**/*.bbl
latex/**/*.bcf
latex/**/*.blg
latex/**/*.fdb_latexmk
latex/**/*.fls
latex/**/*.log
latex/**/*.out
latex/**/*.run.xml
latex/**/*.synctex.gz
latex/**/*.toc
latex/**/*.lof
latex/**/*.lot
latex/**/*.acn
latex/**/*.acr
latex/**/*.alg
latex/**/*.glo
latex/**/*.gls
latex/**/*.glg
latex/**/*.ist
latex/PLCM-Thesis.pdf
